# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_GRAPH_API_VERSION=v18.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — AI (OpenRouter)
# OPTIONAL_AI_PROVIDER_KEY=

# Optional — Email
# OPTIONAL_EMAIL_PROVIDER_KEY=

# Optional — Maps/Geocoding
# OPTIONAL_MAPS_PROVIDER_KEY=

# Optional — Google Contacts (People API sync)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/contacts/google/callback

# Feature flags (P2 integrations — disabled by default)
# FEATURE_CATALOG_SYNC=true
# FEATURE_DOCUMENTS=true
# FEATURE_EMAIL=true
# FEATURE_BROADCASTS=true
# FEATURE_AI=true
# FEATURE_WHATSAPP_CONVERSATIONS=true

# Optional — guards /api/cron/* endpoints (must match Authorization: Bearer header on the cron client)
# CRON_SECRET=your-cron-secret
